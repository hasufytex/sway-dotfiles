#!/usr/bin/env bash
# Admit one window through the scratchpad shortcut. No background process.
set -euo pipefail

: "${SWAYSOCK:?SWAYSOCK is required}" "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
exec {scratch_lock}>"$XDG_RUNTIME_DIR/sway-scratchpad-single.${SWAYSOCK##*/}.lock"
# Serialize the check and move; repeated presses must not race each other.
flock -n "$scratch_lock" || exit 0

choice=$(swaymsg -r -t get_tree | jq -er '
    def walk_windows($scratch; $selected; $floating):
        ($scratch or .name == "__i3_scratch" or
         ((.scratchpad_state // "none") != "none")) as $scratch
        | ($selected or (.focused == true and
                         (.type == "con" or .type == "floating_con"))) as $selected
        | (if (.pid // 0) > 0 or .app_id != null or .window != null then
               {id, scratch: $scratch, selected: $selected,
                group: ($floating // .id)}
           else empty end),
          (.nodes[]? | walk_windows($scratch; $selected; $floating)),
          (.floating_nodes[]? |
               walk_windows($scratch; $selected; ($floating // .id)));
    if .type != "root" then error("Invalid Sway tree") else . end
    | [walk_windows(false; false; null)] as $windows
    | [$windows[] | select(.selected)] as $selected
    | if ($selected | length) != 1 then "selection"
      elif $selected[0].scratch then "hide:\($selected[0].id)"
      elif any($windows[]; .scratch) then "full"
      elif ([$windows[] | select(.group == $selected[0].group)] | length) != 1
           then "group"
      else "add:\($selected[0].id)" end
')

case $choice in
    full) printf '%s\n' 'Scratchpad occupied: restore its window to normal tiling before adding another.' >&2; exit 0 ;;
    group) printf '%s\n' 'Scratchpad limited to one window: select an individual tiled window.' >&2; exit 0 ;;
    selection) printf '%s\n' 'Scratchpad limited to one window: focus an individual window.' >&2; exit 0 ;;
esac
window_id=${choice#*:}
[[ $window_id =~ ^[1-9][0-9]*$ ]] || exit 1
case $choice in
    add:*)
        # Join the scratchpad but remain visible until explicitly hidden.
        swaymsg -q "[con_id=$window_id] move scratchpad; [con_id=$window_id] scratchpad show" ;;
    hide:*) swaymsg -q "[con_id=$window_id] move scratchpad" ;;
    *) exit 1 ;;
esac
