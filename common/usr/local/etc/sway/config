# System-wide sway config, installed as /usr/local/etc/sway/config.
# sway-session uses it for any user without ~/.config/sway/config.
#
# Drop-ins:
#   /usr/local/etc/sway/config.d/*  distro and host parts (session services,
#                                   outputs), linked by install.sh
#   ~/.config/sway/config.d/*       per-user additions, read last, e.g.
#                                   /usr/local/share/sway-dotfiles/sunshine.conf

default_border none
default_floating_border none

seat seat0 xcursor_theme Adwaita 24
exec_always gsettings set org.gnome.desktop.interface cursor-theme Adwaita
exec_always gsettings set org.gnome.desktop.interface cursor-size 24
exec_always gsettings set org.gnome.desktop.interface gtk-theme Adwaita
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark

# Match font rendering across GTK and Fontconfig clients.
exec_always gsettings set org.gnome.desktop.interface font-rendering manual
exec_always gsettings set org.gnome.desktop.interface font-antialiasing rgba
exec_always gsettings set org.gnome.desktop.interface font-hinting slight
exec_always gsettings set org.gnome.desktop.interface font-rgba-order rgb

exec dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Session services (distro) and outputs (host).
include /etc/sway/config.d/*
include /usr/local/etc/sway/config.d/*

# Lock after 10 min idle. Displays stay powered on so they can still be
# captured (for example by Sunshine).
exec swayidle -w \
    timeout 600 'swaylock -f' \
    before-sleep 'swaylock -f'

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

set $mod Mod4

bindsym --no-repeat Mod1+Tab workspace back_and_forth

floating_modifier $mod
tiling_drag enable

bindsym $mod+q exec foot
bindsym $mod+e exec dolphin
bindsym $mod+c kill

bindsym $mod+r exec wmenu-run -f "Liberation Mono 14" -N "#222222" -n "#888888" -S "#222222" -s "#ffffff"
bindsym $mod+b exec bar-toggle

bindsym --no-repeat $mod+Shift+s exec screenshot_save_wl.sh
bindsym --no-repeat $mod+Shift+f exec screenshot_fullscreen_wl.sh

bindsym $mod+p floating toggle

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+t layout toggle tabbed split
bindsym $mod+w split layout tabbed

bindsym $mod+a focus parent

bindsym --no-repeat $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym --no-repeat $mod+l exec swaylock -f

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

mode "resize" {
        bindsym Left        resize shrink width 30 px or 30 ppt
        bindsym Down        resize grow height 30 px or 30 ppt
        bindsym Up          resize shrink height 30 px or 30 ppt
        bindsym Right       resize grow width 30 px or 30 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Ctrl+r mode "resize"

input type:keyboard {
    xkb_layout "us,bg"
    xkb_variant ",phonetic"
    xkb_options "grp:alt_shift_toggle"
    repeat_delay 250
    repeat_rate 40
}

input type:pointer {
    accel_profile flat
}

# Per-user additions last, so they can override anything above.
include ~/.config/sway/config.d/*
