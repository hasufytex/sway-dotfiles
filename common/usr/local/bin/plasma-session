#!/bin/sh
# Launch KDE Plasma with Wayland env. Run from a TTY: plasma-session
# Hardware-specific env comes from /usr/local/etc/desktop-session.d.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

for f in /usr/local/etc/desktop-session.d/*.sh; do
    [ -r "$f" ] && . "$f"
done

# Initialize the PAM-unlocked keyring after creating the desktop session bus.
exec dbus-run-session -- sh -c '
    keyring_env=$(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh) || exit
    eval "$keyring_env"
    export GNOME_KEYRING_CONTROL SSH_AUTH_SOCK
    exec startplasma-wayland "$@"
' plasma-session "$@"
