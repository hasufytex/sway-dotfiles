#!/bin/sh
# Keep exactly one display for screen capture (Sunshine): the virtual
# HEADLESS-1 output is enabled only while no real output is active (monitor
# unplugged, switched off or disabled), so capture always has a screen.
# Started from /usr/local/share/sway-dotfiles/sunshine.conf.

VIRT=HEADLESS-1

real_active() {
    swaymsg -t get_outputs -r |
        jq -e 'any(.[]; (.name | startswith("HEADLESS-") | not) and .active)' >/dev/null
}

virt_active() {
    swaymsg -t get_outputs -r |
        jq -e --arg n "$VIRT" 'any(.[]; .name == $n and .active)' >/dev/null
}

update() {
    if real_active; then
        virt_active && swaymsg -q "output $VIRT disable"
    else
        virt_active || swaymsg -q "output $VIRT enable"
    fi
}

# Create the virtual output once per sway session.
swaymsg -t get_outputs -r | jq -e --arg n "$VIRT" 'any(.[]; .name == $n)' >/dev/null ||
    swaymsg -q create_output

update
swaymsg -t subscribe -m '["output"]' | while read -r _; do update; done
